# RetailFlow POS - Environment Configuration
# Copy this file to .env and adjust values for your deployment

APP_NAME=RetailFlow POS
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true

# Database Configuration
# For SQLite (development/single-computer):
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///data/retailflow.db

# For PostgreSQL (production/multi-terminal):
# DATABASE_TYPE=postgresql
# DATABASE_URL=postgresql://username:password@localhost:5432/retailflow

# Security
SECRET_KEY=change-this-to-a-random-secret-string
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Session
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=8
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=5

# Backup
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_COUNT=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24

# Logging
LOG_DIRECTORY=logs
LOG_LEVEL=DEBUG
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# File Paths
EXPORT_DIRECTORY=exports
REPORT_DIRECTORY=reports